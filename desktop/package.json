{
  "name": "wallbreaker-desktop",
  "productName": "Daedalus",
  "version": "0.1.0",
  "description": "Daedalus Desktop — AI red-team harness in a native shell (package: wallbreaker)",
  "private": true,
  "main": "dist/main.js",
  "author": "JailbrokenAI",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "predev": "node scripts/ensure-dashboard.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "prepack": "node scripts/ensure-dashboard.mjs",
    "pack": "npm run build && electron-builder --dir",
    "predist": "node scripts/ensure-dashboard.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "node scripts/ensure-dashboard.mjs && npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "get-port": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "ai.jailbroken.wallbreaker",
    "productName": "Daedalus",
    "copyright": "Copyright © JailbrokenAI",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "icon": "resources/icon.png",
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/splash.html",
        "to": "splash.html"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daedalus"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
